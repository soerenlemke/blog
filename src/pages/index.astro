---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/urls';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Sören 👋</h1>
			<p>
				I'm a C# and TypeScript developer by day. In my free time I like building things from
				scratch to actually understand how they work — a key-value store in C, a CHIP-8 emulator,
				whatever side project catches my interest that week.
			</p>
			<p>
				This is where I write about what I'm learning along the way: the design decisions, the
				bugs I ran into, and what they taught me.
			</p>
			<p>Check out the <a href={withBase('/blog')}>blog posts</a> to see what I've been working on.</p>
		</main>
		<Footer />
	</body>
</html>