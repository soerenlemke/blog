---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { withBase } from '../utils/urls';
---

<header>
	<nav>
		<h2><a href={withBase('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>Home</HeaderLink>
			<HeaderLink href={withBase('/blog')}>Blog</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/soerenlemke" target="_blank">
				<span class="sr-only">Visit my GitHub profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/sören-lemke-240359263/" target="_blank">
				<span class="sr-only">Visit my LinkedIn profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M14.816 0H1.18C.528 0 0 .519 0 1.161v13.677C0 15.482.528 16 1.18 16h13.635c.653 0 1.184-.518 1.184-1.161V1.16C16 .519 15.469 0 14.816 0zM4.744 13.63H2.37V5.996h2.374v7.634zM3.558 4.955c-.762 0-1.376-.617-1.376-1.377 0-.758.614-1.376 1.376-1.376.76 0 1.376.618 1.376 1.376 0 .76-.616 1.377-1.376 1.377zM13.63 13.63h-2.37V9.917c0-.886-.017-2.024-1.233-2.024-1.234 0-1.423.964-1.423 1.96v3.777H6.234V5.996h2.276v1.043h.032c.317-.6 1.09-1.233 2.245-1.233 2.4 0 2.844 1.581 2.844 3.637v4.187z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>